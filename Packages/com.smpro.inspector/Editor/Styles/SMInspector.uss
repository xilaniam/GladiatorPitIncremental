.sm-box {
    margin: 2px 0 4px 0;
    border-width: 1px;
    border-radius: 3px;
    border-color: var(--unity-colors-default-border);
    background-color: var(--unity-colors-helpbox-background);
}

.sm-box__title {
    -unity-font-style: bold;
    padding: 3px 6px;
    border-bottom-width: 1px;
    border-color: var(--unity-colors-default-border);
}

.sm-box__body {
    padding: 2px 4px 4px 4px;
}

.sm-foldout-group {
    margin: 1px 0;
}

.sm-foldout-group > .unity-foldout__toggle {
    -unity-font-style: bold;
}

.sm-tab-group {
    margin: 2px 0 4px 0;
}

.sm-tab-group .unity-tab__content-container {
    padding: 4px 0 0 0;
}

.sm-title {
    margin: 8px 0 2px 3px;
}

.sm-title__text {
    -unity-font-style: bold;
}

.sm-title__subtitle {
    font-size: 11px;
    color: var(--unity-colors-default-text-hover);
    opacity: 0.7;
}

.sm-title__line {
    height: 1px;
    margin-top: 2px;
    background-color: var(--unity-colors-default-border);
}

.sm-info-box {
    margin: 2px 3px 2px 3px;
}

.sm-validation > .unity-help-box {
    margin: 1px 3px 3px 3px;
}

.sm-suffix {
    flex-direction: row;
    align-items: center;
}

.sm-suffix__label {
    margin: 0 3px 0 4px;
    opacity: 0.7;
}

.sm-button {
    margin: 2px 3px;
    height: 20px;
}

.sm-button--medium {
    height: 26px;
}

.sm-button--large {
    height: 32px;
    -unity-font-style: bold;
}

.sm-button-box {
    margin: 2px 0 4px 0;
    padding: 3px 3px 1px 3px;
    border-width: 1px;
    border-radius: 3px;
    border-color: var(--unity-colors-default-border);
}

.sm-horizontal {
    flex-direction: row;
}

.sm-horizontal__cell {
    min-width: 0;
    margin-right: 6px;
}

.sm-horizontal__cell:last-child {
    margin-right: 0;
}

.sm-horizontal__cell .unity-base-field__label {
    min-width: 0;
    padding-right: 4px;
}
